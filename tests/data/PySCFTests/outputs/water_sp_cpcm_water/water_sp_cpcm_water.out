    "forces",
    "point_group_tol",
    "num_threads",
    "max_memory_mb",
    "settings_digest",
)

#: Replaced with the job's JSON configuration when the script is generated.
CONFIG_JSON = """{
    "schema_version": "2.0",
    "chemsmart_version": "3.4.10",
